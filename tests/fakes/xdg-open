#!/usr/bin/env python3
"""Fake `xdg-open` for tests: records the URL gg tried to open instead of launching a browser.

gg opens links with subprocess.Popen(["xdg-open", url]) (gitgraph.py:3587 and :4506), and tests/env.py
puts tests/fakes first on PATH, so this catches every open. The URL is appended to $FAKE_OPEN_LOG (one
per line); with that variable unset it does nothing at all, which is what a smoke run wants by default.
"""
import os
import sys

path = os.environ.get("FAKE_OPEN_LOG")
if path:
    with open(path, "a", encoding="utf-8") as f:
        f.write((sys.argv[1] if len(sys.argv) > 1 else "") + "\n")
