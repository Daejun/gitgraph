#!/usr/bin/env python3
"""Deterministic stand-in for the `claude` CLI, for tests.

gitgraph picks its AI backend from the basename of `claude_bin` (config key `claude_bin`, env
GITGRAPH_CLAUDE), so this file must stay named `claude` to exercise the real Claude code path in
_ai_call(): `claude -p --no-session-persistence --output-format json --model M PROMPT`, whose stdout is
parsed as JSON with `result` + `usage` + `total_cost_usd`.

What it answers:
  * batch prompts (TR_PROMPT / SUM_PROMPT / WHY_PROMPT — they end with a JSON array payload and demand
    "ONLY a JSON array") -> a JSON array of exactly the payload's length, each element derived from its
    input so a test can tell which entry it belongs to:
        strings (translation)        -> "TR:<original>"
        {"kind","text",...} (summary)-> "SUM:<first 40 chars of text>"
        {"ref","sentence"} (why)     -> "WHY:<ref>"
  * a review prompt (it carries the GG_REVIEW contract) -> a GG_REVIEW block naming the files that
    are actually in the diff it was given, with one finding on the first changed line of each
  * a verification prompt (GG_VERDICT contract) -> a GG_VERDICT block, CONFIRMED by default
  * anything else (TR_FULL_PROMPT full-text translation, ASK_PROMPT question) -> plain text:
        full-text translation        -> "TRFULL:" + the body that followed the prompt header
        question                     -> "ANSWER: <the question line>"

Env vars (all optional):
  FAKE_AI_FAIL=1     exit 1 with a plausible "not logged in" message on stderr  (-> AI_FAILURES)
  FAKE_AI_BAD_LEN=1  return an array of the wrong length                        (-> claude_json raises)
  FAKE_AI_IS_ERROR=1 return a well-formed JSON reply with is_error true
  FAKE_AI_SLEEP=N    sleep N seconds first (pending markers: "» 요약 중…", "⟳ 번역 중…")
  FAKE_AI_VERDICT=S  the raw reply for a verification prompt (default: CONFIRMED)
  FAKE_AI_REVIEW=S   the raw reply for a review prompt (one whose contract marker it carries), instead
                     of the generated one — for malformed-answer tests
  FAKE_AI_LOG=PATH   append one JSON line per call {argv, prompt} so tests can assert batch sizes,
                     context contents and that a cached second call did NOT reach the CLI
"""
import json
import os
import re
import sys
import time


def payload_of(prompt):
    """The JSON array at the end of a batch prompt, or None for a plain-text prompt."""
    tail = prompt.rsplit("\n\n", 1)[-1].strip()
    if not tail.startswith("["):
        return None
    try:
        v = json.loads(tail)
    except ValueError:
        return None
    return v if isinstance(v, list) else None


def answer_for(entry):
    if isinstance(entry, dict):
        if "ref" in entry:
            return f"WHY:{entry['ref']}"
        text = entry.get("text") or entry.get("body") or entry.get("title") or ""
        return f"SUM:{str(text)[:40]}"
    return f"TR:{entry}"


def review_reply(prompt):
    """A pass-1 review answer for the files the prompt's diff actually names, so the anchoring and
    per-file bookkeeping in gitgraph.py are exercised with real paths. FAKE_AI_REVIEW overrides the
    whole reply (a raw string) — used for the malformed-answer tests."""
    override = os.environ.get("FAKE_AI_REVIEW")
    if override is not None:
        return override
    paths, first_add = [], {}
    cur = None
    for line in prompt.splitlines():
        if line.startswith("diff --git a/"):
            cur = line.split(" b/", 1)[-1].split("   (")[0]
            paths.append(cur)
        elif line.startswith("@@") and cur:
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", line)
            if m:
                first_add.setdefault(cur, int(m.group(1)))
        elif line.startswith("+") and cur and cur not in first_add:
            first_add[cur] = 1
    findings = []
    for i, path in enumerate(paths[:2], 1):
        findings.append({"cid": f"CHANGE-{i}", "severity": "bug" if i == 1 else "style",
                         "path": path, "line": first_add.get(path, 1), "side": "RIGHT",
                         "title": f"fake finding {i} in {path}",
                         "body": "the fake AI CLI always says this.",
                         "evidence": f"{path}:{first_add.get(path, 1)}"})
    body = {"reachability": {"verdict": "confirmed", "reason": "fake"},
            "changes": [{"cid": "CHANGE-1", "kind": "control-flow", "path": p, "symbol": "fake_fn",
                         "summary": "fake category"} for p in paths],
            "findings": findings}
    return "here is the review.\n\n<<<GG_REVIEW\n" + json.dumps(body) + "\nGG_REVIEW>>>\n"


def main():
    argv = sys.argv[1:]
    # gitgraph sends a review prompt on stdin (--allowedTools / --add-dir are variadic and would
    # swallow a trailing prompt argument); everything else still comes as the last argv element.
    prompt = "" if sys.stdin.isatty() else sys.stdin.read()
    if not prompt:
        prompt = argv[-1] if argv else ""

    log_path = os.environ.get("FAKE_AI_LOG")
    if log_path:
        with open(log_path, "a", encoding="utf-8") as f:
            f.write(json.dumps({"argv": argv[:-1], "prompt": prompt}, ensure_ascii=False) + "\n")

    sleep = float(os.environ.get("FAKE_AI_SLEEP") or 0)
    if sleep:
        time.sleep(sleep)

    if os.environ.get("FAKE_AI_FAIL"):
        sys.stderr.write("Invalid API key · Please run /login\n")
        return 1

    arr = payload_of(prompt)
    if arr is not None:
        out = [answer_for(e) for e in arr]
        if os.environ.get("FAKE_AI_BAD_LEN"):
            out = out[:-1] if len(out) > 1 else out + ["extra"]
        result = json.dumps(out, ensure_ascii=False)
    elif "GG_VERDICT>>>" in prompt:
        result = os.environ.get("FAKE_AI_VERDICT") or (
            '<<<GG_VERDICT\n{"verdict": "CONFIRMED", "reason": "the fake AI CLI always says this"}'
            "\nGG_VERDICT>>>")
    elif "GG_REVIEW>>>" in prompt:
        result = review_reply(prompt)
    elif "=== question ===" in prompt:
        question = prompt.rsplit("=== question ===", 1)[-1].strip()
        result = f"ANSWER: {question}"
    else:
        body = prompt.rsplit("\n\n", 1)[-1]
        result = "TRFULL:" + body

    reply = {
        "type": "result",
        "is_error": bool(os.environ.get("FAKE_AI_IS_ERROR")),
        "result": result,
        "usage": {"input_tokens": 11, "output_tokens": 7,
                  "cache_read_input_tokens": 100, "cache_creation_input_tokens": 5},
        "total_cost_usd": 0.001,
    }
    if "stream-json" in argv:
        # the streamed form gitgraph's review passes read: an init line, two tool uses (so the live
        # progress path is exercised), then the same result object as the final line
        for ev in ({"type": "system", "subtype": "init"},
                   {"type": "assistant", "message": {"content": [
                       {"type": "tool_use", "name": "Read", "input": {"file_path": "data.c"}}]}},
                   {"type": "assistant", "message": {"content": [
                       {"type": "tool_use", "name": "Grep", "input": {"pattern": "spin_lock"}}]}},
                   reply):
            sys.stdout.write(json.dumps(ev, ensure_ascii=False) + "\n")
        return 0
    sys.stdout.write(json.dumps(reply, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
